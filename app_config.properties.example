# Copy to app_config.properties and set values for YOUR deployment.
# app_config.properties is gitignored — safe for real client IDs.
#
# Default package matches android/app/build.gradle.kts (com.quranjournal.quran_journal).
# See SETUP_OAUTH.md for Google Cloud Console steps.

# ── App identity ──────────────────────────────────────────────────────────
ANDROID_APP_ID=com.quranjournal.quran_journal
IOS_BUNDLE_ID=com.quranjournal.quran_journal
APP_DISPLAY_NAME=Quran Journal

# ── Google OAuth (from Google Cloud Console) ──────────────────────────────
GOOGLE_WEB_CLIENT_ID=REPLACE_ME_get_from_google_cloud_console_web_client
GOOGLE_IOS_CLIENT_ID=REPLACE_ME_get_from_google_cloud_console_ios_client

# ── Backend API (separate repo — point to wherever you deploy it) ─────────
# Android emulator:  http://10.0.2.2:8000
# Physical device:   http://YOUR_PC_OR_SERVER_IP:8000
# Production:        https://your-api.example.com
API_BASE_URL=http://10.0.2.2:8000
